@using Localization.Starter.Web.Utils
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options

@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var currentCulture = Localizations.GetRequestUICulture(Context);
}

<div class="form-inline">
    @foreach (var culture in LocOptions.Value.SupportedUICultures ?? Array.Empty<System.Globalization.CultureInfo>())
    {
        if (!string.Equals(culture.Name, currentCulture.Name, StringComparison.OrdinalIgnoreCase))
        {
            var query = Context.Request.Query.ToDictionary(entry => entry.Key, entry => (string?)entry.Value.ToString());
            query["culture"] = culture.Name;
            query["ui-culture"] = culture.Name;
            var languageUrl = QueryHelpers.AddQueryString(Context.Request.PathBase.Add(Context.Request.Path).ToString(), query);

            <a class="btn btn-language-switcher" id="languageSwitcher-@culture.Name" href="@languageUrl" lang="@culture.Name">@culture.NativeName</a>
        }
    }
</div>